{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GI + Visual Lab v0.1 local contracts",
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claim",
        "source"
      ]
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocked": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "audience",
        "purpose",
        "facts",
        "constraints",
        "unknowns",
        "blocked"
      ]
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VL-[0-9]{2}$"
        },
        "version": {
          "type": "string",
          "enum": [
            "0.1.0"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "CANDIDATE / NOT CORE / TO VALIDATE"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "whenToUse": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "whenNotToUse": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "implementationPattern": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "goodExample": {
          "$ref": "#/$defs/fact"
        },
        "antiExample": {
          "$ref": "#/$defs/fact"
        },
        "failureModes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "repairStrategy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preserveInvariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "cost": {
          "type": "string",
          "minLength": 1
        },
        "transferability": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 1
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "scroll",
                  "pointer",
                  "transformation",
                  "agency",
                  "motion"
                ]
              },
              "uniqueItems": true
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "state-skipping",
                  "flashing",
                  "timeline-mismatch",
                  "pointer-raw",
                  "pointer-lag",
                  "noise-competition",
                  "readability-loss",
                  "agency-loss",
                  "spectacle-loss",
                  "abrupt-settle"
                ]
              },
              "uniqueItems": true
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "frame",
                  "promise",
                  "ambition",
                  "search",
                  "signature",
                  "activation",
                  "generation",
                  "critique",
                  "repair",
                  "human-review",
                  "evidence"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "features",
            "failures",
            "phases"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "status",
        "rule",
        "why",
        "mechanism",
        "whenToUse",
        "whenNotToUse",
        "parameters",
        "dependencies",
        "implementationPattern",
        "goodExample",
        "antiExample",
        "failureModes",
        "tests",
        "repairStrategy",
        "preserveInvariants",
        "cost",
        "transferability",
        "provenance",
        "routing"
      ]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experimentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "candidateVersion": {
          "type": "string",
          "enum": [
            "0.1.0"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "baseline",
            "guided"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "projectTruth": {
          "$ref": "#/$defs/truth"
        },
        "experiencePromise": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "object",
              "additionalProperties": true,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "name",
            "settings"
          ]
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "tools",
            "assets"
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minutes": {
              "type": "number",
              "minimum": 1
            },
            "tokens": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "minutes",
            "tokens"
          ]
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device": {
              "type": "string",
              "minLength": 1
            },
            "viewport": {
              "type": "string",
              "minLength": 1
            },
            "browser": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "device",
            "viewport",
            "browser",
            "task"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "frame",
            "promise",
            "ambition",
            "search",
            "signature",
            "activation",
            "generation",
            "critique",
            "repair",
            "human-review",
            "evidence"
          ]
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "scroll",
              "pointer",
              "transformation",
              "agency",
              "motion"
            ]
          },
          "uniqueItems": true
        },
        "selectedMechanismIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VL-[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "failureIds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "state-skipping",
              "flashing",
              "timeline-mismatch",
              "pointer-raw",
              "pointer-lag",
              "noise-competition",
              "readability-loss",
              "agency-loss",
              "spectacle-loss",
              "abrupt-settle"
            ]
          },
          "uniqueItems": true
        },
        "maxMechanisms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "preserveInvariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "humanDecisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "experimentId",
        "candidateVersion",
        "condition",
        "brief",
        "projectTruth",
        "experiencePromise",
        "model",
        "permissions",
        "budget",
        "evaluation",
        "phase",
        "uncertainty",
        "features",
        "selectedMechanismIds",
        "failureIds",
        "maxMechanisms",
        "preserveInvariants",
        "humanDecisions"
      ]
    },
    "activeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "0.1.0"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "CANDIDATE / NOT CORE / TO VALIDATE"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "baseline",
            "guided"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "frame",
            "promise",
            "ambition",
            "search",
            "signature",
            "activation",
            "generation",
            "critique",
            "repair",
            "human-review",
            "evidence"
          ]
        },
        "projectTruth": {
          "$ref": "#/$defs/truth"
        },
        "experiencePromise": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "humanDecisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preserveInvariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mechanism"
          },
          "minItems": 0
        },
        "activations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mechanismId": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "decisionStatus": {
                "type": "string",
                "enum": [
                  "NOT YET OBSERVED"
                ]
              }
            },
            "required": [
              "mechanismId",
              "reason",
              "decisionStatus"
            ]
          },
          "minItems": 0
        },
        "deferredIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "activeTests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "condition",
        "phase",
        "projectTruth",
        "experiencePromise",
        "uncertainty",
        "constraints",
        "humanDecisions",
        "preserveInvariants",
        "mechanisms",
        "activations",
        "deferredIds",
        "activeTests",
        "instructions"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failureId": {
          "type": "string",
          "enum": [
            "state-skipping",
            "flashing",
            "timeline-mismatch",
            "pointer-raw",
            "pointer-lag",
            "noise-competition",
            "readability-loss",
            "agency-loss",
            "spectacle-loss",
            "abrupt-settle"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "failureId",
        "description",
        "scenario",
        "source"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          },
          "minItems": 1
        }
      },
      "required": [
        "observations"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mechanismId": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "ALFA KNOWLEDGE",
            "MODEL NATIVE",
            "NO CHANGE"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "decisionBefore": {
          "type": "string",
          "minLength": 1
        },
        "decisionAfter": {
          "type": "string",
          "minLength": 1
        },
        "failureTarget": {
          "type": "string",
          "minLength": 1
        },
        "valuePreserved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "mechanismId",
        "origin",
        "why",
        "decisionBefore",
        "decisionAfter",
        "failureTarget",
        "valuePreserved",
        "outcome",
        "evidenceRefs"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "enum": [
            "TECHNICAL EVIDENCE",
            "OBSERVED",
            "HUMAN VERDICT",
            "INFERENCE",
            "HYPOTHESIS",
            "TO VALIDATE"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "TEST",
            "MODEL",
            "HUMAN"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contribution": {
          "type": "string",
          "enum": [
            "NOT EVALUATED",
            "SELF-ATTRIBUTED",
            "CONTROLLED COMPARISON"
          ]
        }
      },
      "required": [
        "id",
        "eventId",
        "label",
        "authority",
        "claim",
        "source",
        "scope",
        "limitations",
        "contribution"
      ]
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expectedFailures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "NOT EVALUABLE"
          ]
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "activeKnowledgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "strengths",
        "risks",
        "expectedFailures",
        "confidence",
        "uncertainty",
        "activeKnowledgeIds"
      ]
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "string",
          "minLength": 1
        },
        "blind": {
          "type": "string",
          "enum": [
            "BLIND",
            "NONBLIND"
          ]
        },
        "verdicts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "firstReaction": {
              "type": "string",
              "minLength": 1
            },
            "premium": {
              "type": "string",
              "minLength": 1
            },
            "wow": {
              "type": "string",
              "minLength": 1
            },
            "customVsTemplate": {
              "type": "string",
              "minLength": 1
            },
            "richness": {
              "type": "string",
              "minLength": 1
            },
            "control": {
              "type": "string",
              "minLength": 1
            },
            "meaningfulEffects": {
              "type": "string",
              "minLength": 1
            },
            "memorability": {
              "type": "string",
              "minLength": 1
            },
            "wouldPay": {
              "type": "string",
              "minLength": 1
            },
            "slowScroll": {
              "type": "string",
              "minLength": 1
            },
            "fastScroll": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "minLength": 1
            },
            "transitionQuality": {
              "type": "string",
              "minLength": 1
            },
            "readability": {
              "type": "string",
              "minLength": 1
            },
            "reverse": {
              "type": "string",
              "minLength": 1
            },
            "perceptualFrameDrop": {
              "type": "string",
              "minLength": 1
            },
            "finishedProduct": {
              "type": "string",
              "minLength": 1
            },
            "uxMotionQuality": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "firstReaction",
            "premium",
            "wow",
            "customVsTemplate",
            "richness",
            "control",
            "meaningfulEffects",
            "memorability",
            "wouldPay",
            "slowScroll",
            "fastScroll",
            "pointer",
            "transitionQuality",
            "readability",
            "reverse",
            "perceptualFrameDrop",
            "finishedProduct",
            "uxMotionQuality"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "evaluator",
        "reviewedAt",
        "device",
        "input",
        "order",
        "blind",
        "verdicts",
        "limitations"
      ]
    }
  }
}
